# Corridor configuration. Copy to .env — never commit .env.
# No secrets are needed in Phase 1: both venue APIs are public reads.

# --- core ---
DB_URL=postgres://corridor:corridor@localhost:5432/corridor?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info            # debug | info | warn | error
PORT=8080

# --- postgres container ---
POSTGRES_PASSWORD=corridor

# --- ingestion cadence (seconds) ---
POLYMARKET_POLL_INTERVAL_S=60   # market metadata refresh
KALSHI_POLL_INTERVAL_S=60
QUOTE_POLL_INTERVAL_S=10        # top-of-book sweep for active markets (both venues)

# --- venue endpoints ---
# WHY overridable: a venue domain change (Kalshi already moved once, from
# trading-api.kalshi.com to api.elections.kalshi.com) becomes a config edit
# instead of a rebuild+deploy. Also lets tests point at local stub servers.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# Kalshi has two hosts (docs.kalshi.com):
#   external-api.kalshi.com      — keyless PUBLIC market data (what we want)
#   api.elections.kalshi.com     — authenticated trading API; requires a
#                                  Key ID + key-signed requests, so anonymous
#                                  market-data polls fail there outright.
# Only switch hosts if Kalshi's docs move the public endpoints again.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# --- politeness ---
USER_AGENT_CONTACT=miraclesayscode@gmail.com   # appended to the CorridorBot/0.1 User-Agent
