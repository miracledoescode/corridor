# Corridor configuration. Copy to .env — never commit .env.
# No secrets are needed in Phase 1: both venue APIs are public reads.

# --- core ---
# DB_URL is the single source of truth for the database (no local Postgres
# in docker-compose anymore — Supabase IS the database). Pick ONE:
#
# Prod (Supabase managed Postgres). Use the TRANSACTION POOLER endpoint —
# host ends in .pooler.supabase.com, port 6543 — NOT the direct :5432 host.
# The pooler multiplexes our many ingestion connections over a few real
# backends; the direct endpoint's connection cap would be exhausted and
# stall ingestion. TLS is mandatory, so keep sslmode=require. URL-encode any
# special characters in the password (or use an alphanumeric one).
DB_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Local/offline dev: bring your own Postgres (pgvector) and point here.
# DB_URL=postgres://corridor:corridor@localhost:5432/corridor?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info            # debug | info | warn | error
PORT=8080

# --- postgres container ---
POSTGRES_PASSWORD=corridor

# --- ingestion cadence (seconds) ---
POLYMARKET_POLL_INTERVAL_S=60   # market metadata refresh
KALSHI_POLL_INTERVAL_S=60
QUOTE_POLL_INTERVAL_S=10        # top-of-book sweep for active markets (both venues)

# --- retention ---
# Daily prune of quotes older than this many days, to stay under the
# Supabase free-tier storage cap. Raise it (or remove the job) once deep
# odds history becomes the product. Default 7.
QUOTE_RETENTION_DAYS=7

# --- spread engine (Phase 3) ---
# How often to scan EXACT, human-reviewed matches for cross-venue arbitrage.
# 0 (the default) disables the engine entirely.
#
# WHY it ships OFF: the engine is only as honest as venues.fee_model. On a
# typical pair the fees are the same order of magnitude as the edge itself, so
# an unverified coefficient turns thin spreads into arbs that do not exist.
# Verify the numbers in migrations/005_fee_models.sql against Kalshi's and
# Polymarket's published fee schedules, THEN set this.
SPREAD_SCAN_INTERVAL_S=0

# --- notify / Telegram (Phase 3) ---
# Empty token = delivery disabled. The spread engine still runs and still
# writes alert rows, so you can watch exactly what it WOULD have sent before
# letting it message anyone. Enable this second, not first.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids for the Pro tier (instant alerts). Get yours by
# messaging the bot and reading getUpdates. Blank = nobody is notified.
TELEGRAM_PRO_CHAT_IDS=
TELEGRAM_WATERMARK=corridor.app
NOTIFY_INTERVAL_S=15

# --- venue endpoints ---
# WHY overridable: a venue domain change (Kalshi already moved once, from
# trading-api.kalshi.com to api.elections.kalshi.com) becomes a config edit
# instead of a rebuild+deploy. Also lets tests point at local stub servers.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# Kalshi has two hosts (docs.kalshi.com):
#   external-api.kalshi.com      — keyless PUBLIC market data (what we want)
#   api.elections.kalshi.com     — authenticated trading API; requires a
#                                  Key ID + key-signed requests, so anonymous
#                                  market-data polls fail there outright.
# Only switch hosts if Kalshi's docs move the public endpoints again.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# --- matcher ---
GROQ_API_KEY="your groq api key here"  # get one at https://app.groq.com

# --- politeness ---
USER_AGENT_CONTACT=miraclesayscode@gmail.com  # appended to the CorridorBot/0.1 User-Agent
